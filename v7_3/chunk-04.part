an></div><p>${p[4]}</p><div class="btnrow"><button class="btn blue" onclick="Game.watch('${p[0]}')">관찰</button><button class="btn" onclick="Game.profile('${p[0]}')">이력 보기</button></div></div>`).join('')}</div></div>`},
 standings(){const rows=[...G.leagueTable].sort((a,b)=>b.pts-a.pts||(b.gf-b.ga)-(a.gf-a.ga));document.querySelector('#page-standings').innerHTML=`<div class="panel pad"><div class="title"><h2>시즌 순위</h2><span class="pill">K리그1 · 동적 시뮬레이션</span></div><div class="tableWrap"><table><thead><tr><th>#</th><th>팀</th><th>승점</th><th>경기</th><th>승</th><th>무</th><th>패</th><th>득실</th></tr></thead><tbody>${rows.map((r,i)=>`<tr class="${r.club===G.club?'me':''}"><td>${i+1}</td><td>${r.club}</td><td><b>${r.pts}</b></td><td>${r.p}</td><td>${r.w}</td><td>${r.d}</td><td>${r.l}</td><td>${r.gf-r.ga}</td></tr>`).join('')}</tbody></table></div></div>`},
 transfer(){if(G.transferOffers.length===0)Game.generateOffers(false);document.querySelector('#page-transfer').innerHTML=`<div class="grid"><div class="c8 panel pad"><div class="title"><h2>이적시장</h2><button class="btn blue" onclick="Game.generateOffers(true)">에이전트에게 새 제안 확인</button></div><div class="cards3">${G.transferOffers.map((o,i)=>`<div class="card"><strong>${o.club}</strong><p>${o.league} · ${o.role}</p><div class="stat"><span>주급</span><b>€${o.wage.toLocaleString()}</b></div><div class="stat"><span>예상 이적료</span><b>${o.fee}</b></div><div class="stat"><span>구단 관심도</span><b>${o.interest}</b></div><div class="btnrow"><button class="btn green" onclick="Game.acceptOffer(${i})">수락</button><button class="btn blue" onclick="Game.negotiateOffer(${i})">재협상</button><button class="btn red" onclick="Game.rejectOffer(${i})">거절</button></div></div>`).join('')||'<div class="notice">현재 공식 제안이 없다.</div>'}</div></div><div class="c4 panel pad"><div class="title"><h2>시장 상황</h2></div><div class="stat"><span>시장 가치</span><b>€${(4.5+G.ovr*0.12).toFixed(1)}M</b></div><div class="stat"><span>현재 주급</span><b>€${G.wage}K</b></div><div class="stat"><span>감독 신뢰</span><b>${G.managerTrust}</b></div><div class="stat"><span>폼</span><b>${G.form}</b></div><div class="notice" style="margin-top:10px">OVR, 최근 평점, 나이, 감독 신뢰에 따라 제안 수준이 달라진다. 상위 리그는 높은 OVR을 요구한다.</div></div></div>`},
 manager(){document.querySelector('#page-manager').innerHTML=`<div class="grid"><div class="c5 panel pad"><div class="title"><h2>감독 관계</h2><span class="pill">신뢰 ${G.managerTrust}</span></div><div class="stat"><span>전술 이해도</span><b>${Math.min(99,52+Math.floor(G.managerTrust/2))}</b></div><div class="stat"><span>선발 경쟁력</span><b>${Math.min(99,50+Math.floor(G.form/2))}</b></div><div class="stat"><span>프로의식</span><b>${Math.min(99,58+Math.floor(G.morale/3))}</b></div><div class="btnrow" style="margin-top:10px"><button class="btn green" onclick="Game.managerAction('talk')">감독과 면담</button><button class="btn blue" onclick="Game.managerAction('role')">역할 문의</button><button class="btn red" onclick="Game.managerAction('demand')">출전 요구</button></div></div><div class="c7 panel pad"><div class="title"><h2>감독 코멘트</h2></div><div class="notice">“Logan은 기술적으로 성장 여지가 크다. 다만 경기 후 회복과 집중력 유지가 중요하다. 팀을 위한 움직임을 더 보여주면 주전 경쟁에서 큰 이점을 가질 것이다.”</div><h3 style="margin:14px 0 8px">관계 로그</h3><div class="feed">${G.history.slice(0,5).map(h=>`<div class="feedItem"><div class="feedIcon">🎙️</div><div><h4>${h}</h4></div></div>`).join('')}</div></div></div>`},
 life(){const sc=scenes.find(s=>s[0]===G.scene)||scenes[0];document.querySelector('#page-life').innerHTML=`<div class="lifeWrap"><div class="panel portraitPanel"><img src="${sc[2]}" alt="harin"><div class="portraitInfo"><span class="pill">${G.relationStage}</span><h1>하린 ❤️</h1><div class="sub">24세 · 배우 · 현재 장면: ${sc[1]}</div><div class="btnrow" style="margin-top:10px"><button class="btn pink" onclick="Game.message()">메시지 보내기</button><button class="btn blue" onclick="Game.gift()">선물하기</button><button class="btn green" onclick="Game.advanceRelation()">관계 발전</button></div></div></div><div class="storyPanel"><div class="panel pad"><div class="title"><h2>연애 스토리 허브</h2><span class="pill">애정 ${G.affection} / 신뢰 ${G.trust}</span></div><div class="storyText">${sc[3]} 지금 관계 단계는 <b>${G.relationStage}</b>이며, 최근엔 <b>${G.history[0]}</b>가 있었다. 웹 V7.3은 <b>하나의 고화질 기준 얼굴</b>을 11개 장면에 고정해 얼굴이 바뀌거나 깨지는 문제를 우선 차단했다. 작은 시트 이미지를 확대하는 방식은 완전히 폐기했다.</div><div class="title" style="margin-top:14px"><h2>${G.partner}의 순간들</h2><button class="btn" onclick="Game.randomScene()">다른 사진 보기</button></div><div class="albumRow">${scenes.map(s=>`<button class="thumb ${G.scene===s[0]?'active':''}" onclick="Game.setScene('${s[0]}')"><img src="${s[2]}" alt="${s[1]}"><span>${s[1]}</span></button>`).join('')}</div><div class="title" style="margin-top:14px"><h2>데이트 장소 선택</h2></div><div class="locationGrid">${places.map(p=>`<button class="locCard" onclick="Game.date('${p[0]}',${p[3]},${p[4]})"><img src="${p[2]}" alt="${p[1]}"><div class="overlay"><b>${p[1]}</b><small>애정 +${p[3]} · ${money(p[4])}</small></div></button>`).join('')}</div></div></div><div class="rightCol"><div class="panel pad"><div class="title"><h2>관계 현황</h2></div><div class="stat"><span>애정</span><b>${G.affection}</b></div><div class="bar"><i style="width:${G.affection}%;background:linear-gradient(90deg,var(--pink),#ff8dc2)"></i></div><div class="stat"><span>신뢰</span><b>${G.trust}</b></div><div class="bar"><i style="width:${G.trust}%;background:linear-gradient(90deg,var(--blue),#9ad1ff)"></i></div><div class="stat"><span>관계 단계</span><b>${G.relationStage}</b></div><div class="stat"><span>가족 구성</span><b>${G.children}명</b></div></div><div class="panel pad" style="margin-top:10px"><div class="title"><h2>스토리 로그</h2></div><div class="feed">${G.history.slice(0,8).map(h=>`<div class="feedItem"><div class="feedIcon">💗</div><div><h4>${h}</h4></div></div>`).join('')}</div></div></div></div>`},
 shopping(){document.querySelector('#page-shopping').innerHTML=`<div class="panel pad"><div class="title"><h2>자산 / 쇼핑</h2><span class="pill">보유 현금 ${money(G.money)}</span></div><div class="cards3">${shop.map((s,i)=>`<div class="card"><strong>${s[1]} ${s[0]}</strong><p>${s[3]}</p><div class="stat"><span>가격</span><b>${money(s[2])}</b></div><button class="btn green" onclick="Game.buy(${i})">구매</button></div>`).join('')}</div><div class="title" style="margin-top:14px"><h2>보유 자산</h2></div><div class="btnrow">${G.inventory.length?G.inventory.map(x=>`<span class="pill">${x}</span>`).join(''):'<span class="muted">아직 보유 자산이 없습니다.</span>'}</div></div>`},
 retire(){const c=G.coachCareer;document.querySelector('#page-retire').innerHTML=G.stage==='retired'?`<div class="grid"><div class="c7 panel pad"><div class="title"><h2>감독 커리어 · ${c.path||'진로 선택'}</h2><span class="pill">레벨 ${c.level}</span></div>${c.active?`<div class="stat"><span>현재 구단</span><b>${c.club}</b></div><div class="stat"><span>보드 신뢰</span><b>${c.board}</b></div><div class="stat"><span>이적 예산</span><b>${money(c.budget)}</b></div><div class="stat"><span>감독 전적</span><b>${c.w}승 ${c.d}무 ${c.l}패</b></div><div class="btnrow" style="margin-top:10px"><button class="btn green" onclick="Game.coachAction('training')">훈련 설계</button><button class="btn blue" onclick="Game.coachAction('transfer')">선수 영입</button><button class="btn gold" onclick="Game.coachAction('press')">기자회견</button></div>`:`<div class="cards3">${coachTracks.map((t,i)=>`<div class="card"><strong>${t[0]}</strong><p>${t[1]}</p><span class="pill">${t[2]}</span><button class="btn green" onclick="Game.startCoach('${t[0]}')">이 진로 선택</button></div>`).join('')}</div>`}</div><div class="c5 panel pad"><h2>선수 시절 레거시</h2><div class="stat"><span>통산 출전</span><b>${G.apps}</b></div><div class="stat"><span>골</span><b>${G.goals}</b></div><div class="stat"><span>도움</span><b>${G.assists}</b></div><div class="stat"><span>최종 OVR</span><b>${G.ovr}</b></div></div></div>`:`<div class="grid"><div class="c7 panel pad"><div class="title"><h2>은퇴 후 감독 커리어</h2><span class="pill">30세 이후 해금</span></div><div class="notice">선수 은퇴 후에는 지도자 자격 → 코치 → 감독 → 단장/구단주로 이어지는 별도 게임 루프가 시작된다. 감독 커리어에서는 전술, 선수 영입, 보드 신뢰, 경기 결과를 관리한다.</div><div class="cards4" style="margin-top:10px">${coachTracks.map(t=>`<div class="card"><strong>${t[0]}</strong><p>${t[1]}</p><span class="pill">${t[2]}</span></div>`).join('')}</div>${G.age>=30?`<button class="btn red" style="margin-top:12px" onclick="Game.retireNow()">현역 은퇴 선언</button>`:`<p class="muted" style="margin-top:12px">현재 ${G.age}세. 30세부터 자발적 은퇴 가능.</p>`}</div><div class="c5 panel pad"><h2>현재 레거시</h2><div class="stat"><span>통산 출전</span><b>${G.apps}</b></div><div class="stat"><span>통산 골</span><b>${G.goals}</b></div><div class="stat"><span>통산 도움</span><b>${G.assists}</b></div><div class="stat"><span>예상 지도자 명성</span><b>${Math.round((G.ovr+G.managerTrust+G.morale)/3)}</b></div></div></div>`},
 settings(){document.querySelector('#page-settings').innerHTML=`<div class="panel pad"><div class="title"><h2>설정</h2></div><div class="btnrow"><button class="btn blue" onclick="Game.exportSave()">세이브 내보내기</button><button class="btn red" onclick="Game.reset()">커리어 초기화</button></div><div class="notice" style="margin-top:12px">V7.3은 사진을 <b>동일 마스터 얼굴 기반 11장</b>으로 강제 일관성 처리했고, 경기 선택형 플레이·동적 순위·이적 협상·160개 라이브 이벤트·은퇴 후 감독 커리어를 추가했다.</div></div>`},
 renderAll(){this.renderTop();const page=(document.querySelector('.nav button.active')||{}).dataset?.page||'home';this.renderPage(page)},
 toast(msg){const el=document.createElement('div');el.className='toast';el.textContent=msg;toasts.appendChild(el);setTimeout(()=>el.remove(),2400)},
 modal(title,html){