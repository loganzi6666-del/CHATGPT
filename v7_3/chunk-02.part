const eventVariations=['프리시즌','중요 경기 전','연승 중','부진 탈출 직후','대표팀 기간','이적시장 막판','더비 주간','컵대회 주간'];
const eventContexts=['감독','에이전트','연애','팀 동료','SNS','국가대표','스폰서','가족','팬','언론'];
const liveEvents=[];
outer: for(const base of liveEventsSeed){
  for(const v of eventVariations){
    for(const c of eventContexts){
      liveEvents.push([`${base[0]} · ${v}`,`${base[1]} (${c} 관련 상황)`,[...base[2]]]);
      if(liveEvents.length>=160) break outer;
    }
  }
}
