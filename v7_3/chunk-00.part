<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>FOOTBALL LIFE 7.3 · Web</title>
<style>
:root{--bg:#04131d;--bg2:#081b29;--panel:#0a1d2a;--panel2:#0e2433;--line:#173c52;--txt:#eef7fb;--muted:#8ca6b6;--green:#5bf0b0;--blue:#68b7ff;--pink:#ff589f;--gold:#ffd36a;--red:#ff6e7a;--shadow:0 20px 60px #0007}
*{box-sizing:border-box}html,body{margin:0;background:radial-gradient(circle at 50% -10%,#11344a 0,#07131c 35%,#030b11 100%);color:var(--txt);font-family:Inter,Pretendard,"Noto Sans KR",system-ui,sans-serif}button,input,select{font:inherit}button{cursor:pointer}
.hidden{display:none!important}.muted{color:var(--muted)}
.app{min-height:100vh}.sidebar{position:fixed;left:0;top:0;bottom:0;width:250px;background:linear-gradient(180deg,#04131cf6,#061722f6);border-right:1px solid #12384c;padding:14px 10px;display:flex;flex-direction:column;gap:10px;z-index:30}.brand{font-size:24px;font-weight:1000}.brand span{color:var(--green)}.profile{border:1px solid var(--line);border-radius:14px;background:#091f2d;padding:10px;display:grid;grid-template-columns:72px 1fr;gap:10px}.profile img{width:72px;height:92px;object-fit:cover;border-radius:10px}.profile strong{display:block;font-size:18px}.profile small{display:block;color:#a9bec9;margin-top:2px}.kpis{display:grid;gap:4px}.kpiRow{display:flex;justify-content:space-between;font-size:11px;color:#c8dbe4}.bar{height:8px;background:#0f3042;border-radius:999px;overflow:hidden;margin-top:4px}.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--green),#a8ffd8)}
.nav{display:grid;gap:4px;overflow:auto;padding-right:2px}.nav button{border:0;background:transparent;color:#c3d5df;border-radius:10px;padding:10px 12px;text-align:left;font-size:13px;display:flex;align-items:center;gap:8px}.nav button:hover{background:#0b2332}.nav button.active{background:linear-gradient(90deg,#ff5aa1,#d7c8ff);color:#07111b;font-weight:900}.quote{margin-top:auto;font-size:11px;color:#8fa8b6;text-align:center;padding:8px}
.main{margin-left:250px}.topbar{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:12px;justify-content:space-between;height:66px;background:#04121ddd;border-bottom:1px solid #11384d;padding:0 14px;backdrop-filter:blur(18px)}.topLeft{display:flex;gap:8px;align-items:center}.datebox b{display:block;font-size:20px}.datebox small{color:var(--muted)}.headerStats{display:flex;gap:18px;align-items:center}.headerStats div{text-align:right}.headerStats b{display:block;font-size:22px}.advance{border:0;padding:14px 20px;border-radius:10px;background:linear-gradient(135deg,#6df7c2,#2ddf9d);color:#051811;font-weight:1000;box-shadow:0 8px 32px #23dc9644}
.page{display:none;padding:14px;max-width:1600px;margin:auto}.page.active{display:block}.grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:10px}.c3{grid-column:span 3}.c4{grid-column:span 4}.c5{grid-column:span 5}.c6{grid-column:span 6}.c7{grid-column:span 7}.c8{grid-column:span 8}.c9{grid-column:span 9}.c12{grid-column:span 12}
.panel{background:linear-gradient(160deg,#081b28,#071722);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);overflow:hidden}.pad{padding:12px}.title{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.title h2{margin:0;font-size:19px}.pill{display:inline-flex;padding:4px 8px;border-radius:999px;border:1px solid #1b526c;background:#0e3144;color:#d7e5ec;font-size:10px}.btn{border:1px solid #21516b;background:#0a2737;color:#fff;border-radius:10px;padding:10px 12px;font-weight:800;font-size:12px}.btn:hover{transform:translateY(-1px)}.btn.green{background:linear-gradient(135deg,#61f3b5,#2ecf8c);color:#062015;border:0}.btn.blue{background:linear-gradient(135deg,#7bc6ff,#478bf4);color:#071728;border:0}.btn.pink{background:linear-gradient(135deg,#ff62a7,#ec3c8d);color:#220814;border:0}.btn.gold{background:linear-gradient(135deg,#ffe08a,#d7aa32);color:#2b1d00;border:0}.btn.red{background:linear-gradient(135deg,#ff9098,#e85f67);color:#2a0608;border:0}.btnrow{display:flex;flex-wrap:wrap;gap:8px}
.stat{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #123649;font-size:12px}.stat:last-child{border-bottom:0}.metricGrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.metric{padding:14px}.metric .big{font-size:30px;font-weight:1000}.metric small{color:var(--muted)}
.homeHero{display:grid;grid-template-columns:2fr 1fr;min-height:280px}.heroCover{position:relative}.heroCover img{width:100%;height:100%;object-fit:cover}.heroCover:after{content:"";position:absolute;inset:45% 0 0;background:linear-gradient(transparent,#04131deb)}.heroText{position:absolute;left:18px;bottom:18px;right:18px;z-index:2}.heroText h1{margin:6px 0 8px;font-size:34px}.heroAside{padding:16px;background:linear-gradient(180deg,#0a2231,#081925)}.notice{padding:12px;border-radius:12px;background:#0a2435;border:1px solid #18465e;color:#c6d8e0;font-size:12px;line-height:1.6}
.lifeWrap{display:grid;grid-template-columns:420px 1fr 300px;gap:10px}.portraitPanel{position:relative;height:520px}.portraitPanel img{width:100%;height:100%;object-fit:cover;object-position:center 18%;image-rendering:auto}.portraitPanel:after{content:"";position:absolute;inset:55% 0 0;background:linear-gradient(transparent,#020d15f0)}.portraitInfo{position:absolute;left:16px;bottom:14px;right:16px;z-index:2}.portraitInfo h1{margin:6px 0 8px;font-size:42px}.portraitInfo .sub{font-size:15px;color:#dceaf1}.storyPanel .storyText{padding:12px;border-radius:12px;background:#0a2231;border:1px solid #153d54;line-height:1.7;color:#d9e6ee}.albumRow{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}.thumb{background:#091a26;border:2px solid transparent;border-radius:10px;overflow:hidden;padding:0;height:100px;position:relative}.thumb img{width:100%;height:100%;object-fit:cover}.thumb.active{border-color:var(--pink)}.thumb span{position:absolute;left:5px;right:5px;bottom:4px;background:#000b;border-radius:6px;padding:3px 4px;font-size:9px}.locationGrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.locCard{position:relative;height:112px;border-radius:12px;overflow:hidden;border:1px solid #184960;background:#061c2a}.locCard img{width:100%;height:100%;object-fit:cover;filter:brightness(.72)}.locCard .overlay{position:absolute;inset:auto 8px 8px 8px}.locCard b{display:block;font-size:12px;text-shadow:0 2px 6px #000}.locCard small{color:#dbebf3;text-shadow:0 2px 6px #000;display:block;margin-top:2px}.feed{display:grid;gap:8px}.feedItem{display:grid;grid-template-columns:40px 1fr;gap:8px;padding:9px;border-bottom:1px solid #123649}.feedItem:last-child{border-bottom:0}.feedIcon{width:32px;height:32px;border-radius:9px;background:#0f3850;display:grid;place-items:center}.feedItem h4{margin:0;font-size:12px}.feedItem p{margin:4px 0 0;color:#ccdae2;font-size:11px;line-height:1.5}.feedItem small{color:#7990a0}
.tableWrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:720px}th,td{padding:10px;border-bottom:1px solid #12384c;text-align:left;font-size:12px}th{font-size:10px;color:#89a4b3;text-transform:uppercase;letter-spacing:.08em}tr.me{background:#0a2a3c}.cards3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.cards4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.card{padding:12px;border:1px solid #18445b;background:#081d2b;border-radius:12px}.card strong{display:block;font-size:15px}.card p{font-size:12px;color:#c9d9e1;line-height:1.55}.search{width:100%;padding:12px;border-radius:10px;border:1px solid #1b5068;background:#071722;color:#fff}
.modal{position:fixed;inset:0;z-index:100;background:#000b;display:grid;place-items:center;padding:20px}.modalCard{width:min(760px,96vw);max-height:90vh;overflow:auto;background:#081a28;border:1px solid #285f7c;border-radius:16px;padding:18px;box-shadow:var(--shadow)}.toastBox{position:fixed;right:14px;bottom:14px;z-index:120;display:grid;gap:8px}.toast{background:#eefff5;color:#072015;padding:10px 12px;border-radius:9px;font-size:11px;font-weight:900;box-shadow:0 10px 30px #0008}
@media(max-width:1200px){.lifeWrap{grid-template-columns:1fr}.portraitPanel{height:420px}.locationGrid{grid-template-columns:repeat(2,minmax(0,1fr))}.albumRow{grid-template-columns:repeat(3,minmax(0,1fr))}.cards4{grid-template-columns:repeat(2,minmax(0,1fr))}.metricGrid{grid-template-columns:repeat(2,minmax(0,1fr))}.homeHero{grid-template-columns:1fr}}
@media(max-width:900px){.sidebar{position:static;width:auto;height:auto}.main{margin-left:0}.topbar{position:static}.profile{grid-template-columns:64px 1fr}.page{padding:10px}.cards3,.cards4,.metricGrid{grid-template-columns:1fr}.topbar{flex-wrap:wrap;height:auto;padding:10px}.headerStats{gap:10px}.lifeWrap{grid-template-columns:1fr}.locationGrid{grid-template-columns:1fr 1fr}.homeHero{grid-template-columns:1fr}}
</style>
</head><body>
<div class="app">
  <aside class="sidebar">
    <div class="brand">FOOTBALL LIFE <span>7.3</span></div>
    <div class="profile">
      <img src="data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22200%22%20height%3D%22260%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22g%22%20x1%3D%220%22%20y1%3D%220%22%20x2%3D%221%22%20y2%3D%221%22%3E%3Cstop%20stop-color%3D%22%23132d3d%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%232ed89a%22%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Crect%20width%3D%22200%22%20height%3D%22260%22%20rx%3D%2224%22%20fill%3D%22url%28%23g%29%22%2F%3E%3Ccircle%20cx%3D%22100%22%20cy%3D%2292%22%20r%3D%2244%22%20fill%3D%22%23dfeff4%22%20opacity%3D%22.9%22%2F%3E%3Crect%20x%3D%2248%22%20y%3D%22145%22%20width%3D%22104%22%20height%3D%2272%22%20rx%3D%2228%22%20fill%3D%22%23dfeff4%22%20opacity%3D%22.9%22%2F%3E%3Ctext%20x%3D%22100%22%20y%3D%22245%22%20text-anchor%3D%22middle%22%20fill%3D%22white%22%20font-family%3D%22sans-serif%22%20font-size%3D%2222%22%20font-weight%3D%22700%22%3ELOGAN%3C%2Ftext%3E%3C%2Fsvg%3E" alt="player">
