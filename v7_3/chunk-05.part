modal.classList.remove('hidden');modalTitle.textContent=title;modalBody.innerHTML=html},closeModal(){modal.classList.add('hidden')}
};
const Game={
 setScene(id){G.scene=id;save();UI.life()}, randomScene(){G.scene=scenes[Math.floor(Math.random()*scenes.length)][0];save();UI.life()},
 date(id,plus,cost){if(G.money<cost)return UI.toast('잔액이 부족합니다.');G.money-=cost;G.affection=clamp(G.affection+plus);G.trust=clamp(G.trust+Math.max(1,Math.floor(plus/2)));if(['cafe','shopping','stadium'].includes(id))G.scene=id;else if(['restaurant','cinema','drive','hotel'].includes(id))G.scene='night';else if(id==='themepark')G.scene='travel';G.history.unshift(`하린과 ${id} 데이트를 했다.`);save();UI.renderAll();UI.toast(`데이트 성공 · 애정 +${plus}`)},
 message(){G.trust=clamp(G.trust+2);G.history.unshift('하린에게 메시지를 보냈다.');save();UI.renderAll();UI.toast('메시지를 보냈습니다.')}, gift(){if(G.money<1200000)return UI.toast('잔액이 부족합니다.');G.money-=1200000;G.affection=clamp(G.affection+3);G.history.unshift('하린에게 선물을 했다.');save();UI.renderAll();UI.toast('선물을 보냈습니다.')},
 advanceRelation(){if(G.relationStage==='연애'&&G.affection>=85&&G.trust>=80){G.relationStage='약혼';G.scene='proposal';G.history.unshift('하린에게 프로포즈했고 약혼했다.');}
 else if(G.relationStage==='약혼'&&G.affection>=92&&G.trust>=86){G.relationStage='결혼';G.scene='wedding';G.history.unshift('하린과 결혼했다.');}
 else if(G.relationStage==='결혼'&&G.children<2){G.children++;G.scene='family';G.history.unshift('가족이 한 명 늘었다.');}
 else return UI.toast('관계 발전 조건이 아직 부족합니다.'); save();UI.renderAll();UI.toast('관계가 발전했습니다.')},
 quickTrain(){if(G.fitness<20)return UI.toast('컨디션이 너무 낮습니다.');G.fitness=clamp(G.fitness-6);G.form=clamp(G.form+2);if(Math.random()<0.2)G.ovr++;save();UI.renderAll();UI.toast('가벼운 경기 전 훈련을 마쳤습니다.')},
 recover(n,cost,name){if(G.money<cost)return UI.toast('잔액이 부족합니다.');G.money-=cost;G.fitness=clamp(G.fitness+n);G.morale=clamp(G.morale+1);save();UI.renderAll();UI.toast(`${name} · 컨디션 +${n}`)},
 buy(i){const s=shop[i];if(G.money<s[2])return UI.toast('잔액이 부족합니다.');G.money-=s[2];G.inventory.push(s[0]);G.morale=clamp(G.morale+2);save();UI.renderAll();UI.toast(`${s[0]} 구매 완료`)},
 profile(name){const p=players.find(x=>x[0]===name);if(!p)return;UI.modal(p[0],`<p><span class="pill">${p[1]}</span> <span class="pill">${p[2]}</span> <span class="pill">${p[3]}</span></p><p class="muted">${p[4]}</p><div class="notice">V7에서는 선수·감독·레전드 DB를 확장하고, 관찰한 인물은 향후 인간관계 / 이적시장 / 라이브 이벤트에 연결되게 만들 계획이다.</div>`)},
 watch(name){if(!G.watched.includes(name))G.watched.push(name);save();UI.toast(`${name} 관찰을 시작합니다.`)},
 transfer(club){G.club=club;G.money+=10000000;G.managerTrust=clamp(G.managerTrust-4);G.history.unshift(`${club}로 이적했다.`);save();UI.renderAll();UI.toast(`${club} 이적 완료`)},
 managerAction(type){if(type==='talk'){G.managerTrust=clamp(G.managerTrust+4);G.history.unshift('감독과 대화를 나눴다.');UI.toast('감독 신뢰가 상승했습니다.');}
 if(type==='role'){G.managerTrust=clamp(G.managerTrust+2);G.history.unshift('감독에게 역할을 문의했다.');UI.toast('플레이 역할을 확인했습니다.');}
 if(type==='demand'){G.managerTrust=clamp(G.managerTrust-6);G.history.unshift('감독에게 출전 기회를 강하게 요구했다.');UI.toast('감독이 부담을 느낍니다.');}
 save();UI.renderAll();},
 answerEvent(idx,choice){const e=G.inbox[idx];if(!e)return;G.inbox.splice(idx,1);if(choice===0){G.morale=clamp(G.morale+2);G.managerTrust=clamp(G.managerTrust+1);} else if(choice===1){G.fitness=clamp(G.fitness+2);G.affection=clamp(G.affection+1);} else {G.morale=clamp(G.morale-1);G.trust=clamp(G.trust-1);}G.history.unshift(`${e[0]} 이벤트에서 '${e[2][choice]}' 선택.`);save();UI.renderAll();UI.toast('선택이 반영됐습니다.')},
 startMatch(){if(G.matchSession)return;const f=G.fixtures[0];if(!f)return UI.toast('남은 일정이 없습니다.');G.matchSession={opp:f[0],comp:f[1],minute:1,us:0,them:Math.random()<.28?1:0,left:5,rating:6.4,energy:G.fitness,goals:0,assists:0,log:['킥오프. 오늘 경기는 직접 선택으로 진행된다.']};save();UI.match()},
 matchAction(type){const m=G.matchSession;if(!m)return;const base={shoot:.43,pass:.48,dribble:.42,press:.58,safe:.72,hero:.29}[type]||.4;const skill=clamp((G.ovr-60)/70,0,.4);const ok=Math.random()<base+skill;m.minute=Math.min(90,m.minute+Math.floor(10+Math.random()*12));m.energy=clamp(m.energy-(type==='press'||type==='dribble'?8:5));let msg='';if(ok){if(type==='shoot'||type==='hero'){if(Math.random()<.48){m.us++;m.goals++;m.rating+=.8;msg=`${m.minute}' ⚽ 직접 마무리 성공!`;}else{m.rating+=.15;msg=`${m.minute}' 유효 슈팅을 만들었다.`}}else if(type==='pass'){if(Math.random()<.42){m.us++;m.assists++;m.rating+=.55;msg=`${m.minute}' 🅰️ 킬패스가 골로 연결됐다.`}else{m.rating+=.16;msg=`${m.minute}' 결정적 패스로 찬스를 만들었다.`}}else if(type==='dribble'){m.rating+=.25;msg=`${m.minute}' 드리블로 수비 라인을 무너뜨렸다.`}else if(type==='press'){m.rating+=.2;G.managerTrust=clamp(G.managerTrust+1);msg=`${m.minute}' 전방 압박 성공. 감독이 만족해한다.`}else{m.rating+=.08;msg=`${m.minute}' 안전하게 점유를 이어갔다.`}}else{m.rating-=type==='hero'?.35:.15;msg=`${m.minute}' 선택이 실패해 공격권을 잃었다.`;if(Math.random()<.2)m.them++;}if(Math.random()<.12)m.them++;m.left--;m.rating=clamp(m.rating,4.5,10);m.log.push(msg);if(m.left<=0||m.minute>=88)this.finishMatch();else{save();UI.match()}},
 finishMatch(){const m=G.matchSession;if(!m)return;G.fixtures.shift();G.apps++;G.goals+=m.goals;G.assists+=m.assists;G.fitness=clamp(m.energy);G.form=clamp(G.form+Math.round((m.rating-6.5)*3));G.managerTrust=clamp(G.managerTrust+Math.round((m.rating-6.5)*2));const result=m.us>m.them?'승':m.us<m.them?'패':'무';G.lastMatch={opp:m.opp,res:`${m.us}-${m.them} ${result}`,rating:m.rating.toFixed(1),goals:m.goals,assists:m.assists};G.history.unshift(`${m.comp} ${m.opp}전 ${m.us}-${m.them} ${result} · 평점 ${m.rating.toFixed(1)} · ${m.goals}골 ${m.assists}도움`);this.updateLeague(G.club,m.opp,m.us,m.them);G.matchSession=null;save();UI.renderAll();UI.toast('경기가 종료되었습니다.')},
 updateLeague(a,b,ga,gb){let A=G.leagueTable.find(x=>x.club===a),B=G.leagueTable.find(x=>x.club===b);if(!A){A={club:a,pts:0,p:0,w:0,d:0,l:0,gf:0,ga:0};G.leagueTable.push(A)}if(!B){B={club:b,pts:0,p:0,w:0,d:0,l:0,gf:0,ga:0};G.leagueTable.push(B)}[[A,ga,gb],[B,gb,ga]].forEach(([t,gf,gx])=>{t.p++;t.gf+=gf;t.ga+=gx});if(ga>gb){A.w++;A.pts+=3;B.l++}else if(ga<gb){B.w++;B.pts+=3;A.l++}else{A.d++;B.d++;A.pts++;B.pts++}},
 generateOffers(show=true){const level=G.ovr+Math.round(G.form/10);const eligible=clubOfferPool.filter((x,i)=>i<6||level>68+(i-5)*2).sort(()=>Math.random()-.5).slice(0,Math.max(1,Math.min(4,1+Math.floor((level-60)/5))));G.transferOffers=eligible.map(x=>({club:x[0],league:x[1],wage:Math.round(x[2]*(.9+Math.random()*.25)),role:x[3],fee:x[4],interest:clamp(Math.round(50+(level-65)*3+Math.random()*18))}));save();if(show){UI.transfer();UI.toast('새로운 이적 제안을 확인했습니다.')}},
 acceptOffer(i){const o=G.transferOffers[i];if(!o)return;G.club=o.club;G.wage=Math.round(o.wage/1000);G.managerTrust=50;G.history.unshift(`${o.club}로 이적했다. 주급 €${o.wage.toLocaleString()}.`);G.transferOffers=[];save();UI.renderAll();UI.toast(`${o.club} 이적 완료`)},
 negotiateOffer(i){const o=G.transferOffers[i];if(!o)return;if(Math.random()<.58){o.wage=Math.round(o.wage*1.12);o.interest=clamp(o.interest-4);UI.toast('재협상 성공. 주급이 인상됐습니다.')}else{o.interest=clamp(o.interest-12);UI.toast('구단이 추가 인상을 거절했습니다.')}save();UI.transfer()},
 rejectOffer(i){G.transferOffers.splice(i,1);save();UI.transfer()},
 retireNow(){if(G.age<30)return UI.toast('30세부터 자발적 은퇴가 가능합니다.');G.stage='retired';G.matchSession=null;G.coachCareer={active:false,path:'',level:0,club:'',board:55,budget:30000000,w:0,d:0,l:0,reputation:Math.round((G.ovr+G.managerTrust)/2)};G.history.unshift(`${G.age}세에 현역에서 은퇴했다.`);save();UI.renderAll();UI.show('retire')},
 startCoach(path){G.coachCareer.active=true;G.coachCareer.path=path;G.coachCareer.level=1;G.coachCareer.club=path==='1군 감독'?G.club:'유소년 아카데미';G.history.unshift(`은퇴 후 ${path} 커리어를 시작했다.`);save();UI.retire();UI.toast(`${path} 커리어 시작`)},
 coachAction(type){const c=G.coachCareer;if(!c.active)return;if(type==='training'){c.board=clamp(c.board+2);c.reputation=clamp(c.reputation+2)}if(type==='transfer'){if(c.budget<5000000)return UI.toast('이적 예산이 부족합니다.');c.budget-=5000000;c.reputation=clamp(c.reputation+3)}if(type==='press'){c.board=clamp(c.board+(Math.random()>.35?2:-3));c.reputation=clamp(c.reputation+1)}save();UI.retire();UI.toast('감독 커리어 선택이 반영됐습니다.')},
 advanceWeek(){if(G.matchSession){UI.show('match');return UI.toast('진행 중인 경기를 먼저 끝내세요.')}G.week++;G.day+=7;if(G.day>28){G.day-=28;G.month++;if(G.month>12){G.month=1;G.year++;G.age++;}}if(G.stage==='retired'){const c=G.coachCareer;if(c.active){const r=Math.random();if(r>.58){c.w++;c.board=clamp(c.board+2)}else if(r>.28)c.d++;else{c.l++;c.board=clamp(c.board-3)}c.reputation=clamp(c.reputation+(r>.45?1:0))}save();UI.renderAll();return UI.toast('감독 커리어 한 주가 진행되었습니다.')}G.money+=G.wage*1600+G.businessIncome;G.fitness=clamp(G.fitness+6);G.morale=clamp(G.morale+(Math.random()>.5?1:-1));const count=1+Math.floor(Math.random()*3);for(let k=0;k<count;k++){const ev=liveEvents[Math.floor(Math.random()*liveEvents.length)];G.inbox.push(ev)}if(G.inbox.length>12)G.inbox=G.inbox.slice(-12);if(G.week%4===0)this.generateOffers(false);if(Math.random()<.34){G.affection=clamp(G.affection+(Math.random()>.45?1:-2));G.trust=clamp(G.trust+(Math.random()>.5?1:-1))}const headline=[`${G.club}, ${G.fixtures[0]?.[0]||'다음 경기'} 준비 돌입`,`${G.partner}이 경기장 방문을 준비 중`,`${G.name}, 최근 폼 ${G.form>=70?'상승':'점검 필요'}`,`이적시장 루머: ${G.name}에게 관심 증가`,`감독, ${G.name}의 훈련 태도를 공개 평가`][Math.floor(Math.random()*5)];G.news.unshift(headline);G.news=G.news.slice(0,6);save();UI.renderAll();UI.toast(`${count}개의 새 라이브 이벤트가 도착했습니다.`)},
 exportSave(){const blob=new Blob([JSON.st