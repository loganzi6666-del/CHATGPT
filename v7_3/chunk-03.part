'🩺',6200000,'컨디션 관리에 도움'],['패션 쇼핑','🛍️',9500000,'데이트 만족도 상승'],['가족 여행 적금','✈️',14000000,'장기 관계 만족도 상승'],
['슈퍼카','🏎️',480000000,'스타성 +8 · 유지비 증가'],['해외 별장','🏡',2300000000,'자산 가치와 가족 만족 증가'],['고급 오디오 룸','🎧',28000000,'멘탈 +4'],
['게이밍 룸','🎮',18000000,'멘탈 +3'],['개인 셰프','👨‍🍳',42000000,'컨디션 회복 보너스'],['전담 영양사','🥗',36000000,'부상 위험 감소'],
['개인 트레이너','🏋️',50000000,'훈련 성장 보너스'],['개인 미디어팀','📸',75000000,'팬·미디어 관리 보너스'],['명품 의류 패키지','🧥',26000000,'브랜드 가치 상승'],
['요트 지분','🛥️',740000000,'자산 + 명성'],['전용 항공 서비스','🛩️',320000000,'여행 피로 감소'],['유소년 후원','⚽',80000000,'프로의식·명성 상승'],
['개인 브랜드 런칭','🏷️',150000000,'사업 수익 발생'],['부동산 투자','🏢',600000000,'주간 패시브 수익']
];
const coachTracks=[['유소년 코치','선수 육성과 전술 교육에 집중','유망주 성장 보너스'],['1군 감독','전술과 선수 관리 중심','팀 성적 보너스'],['해설가','미디어 활동과 분석력','명성 수익'],['단장 / 구단주','재정과 이적시장 운영','클럽 장기 운영']];

function money(v){if(v>=1e9)return '₩'+(v/1e9).toFixed(1)+'B';if(v>=1e6)return '₩'+(v/1e6).toFixed(1)+'M';return '₩'+v.toLocaleString('ko-KR')}
const clamp=(n,min=0,max=100)=>Math.max(min,Math.min(max,n));
const initialState=()=>({name:'Logan Lee',club:'광주 FC',pos:'CAM',nation:'대한민국',age:18,year:2026,month:7,day:12,week:1,ovr:64,form:67,fitness:94,morale:76,money:55800000,wage:45000,managerTrust:68,scene:'profile',partner:'하린',affection:78,trust:72,relationStage:'연애',children:0,history:['광주 FC에서 프로 커리어를 시작했다.','하린과 카페 데이트로 관계가 시작됐다.'],watched:['Son Heung-min','Pep Guardiola'],inventory:['개인 피지오 패키지'],inbox:[],news:['광주 FC, FA컵 8강 진출 도전','하린이 경기장 방문 계획을 세웠다.'],fixtures:[...fixtures],retired:false,legacy:'',apps:22,goals:7,assists:6,lastMatch:{opp:'대전 하나 시티즌',res:'2-1 승',rating:7.5,goals:1,assists:0}})
let G=JSON.parse(localStorage.getItem('footballLife7')||'null')||initialState();
G.stage=G.stage||'player';G.matchSession=G.matchSession||null;G.transferOffers=G.transferOffers||[];G.leagueTable=G.leagueTable||standingsBase.map(r=>({club:r[0],pts:r[1],p:r[2],w:r[3],d:r[4],l:r[5],gf:r[6],ga:r[7]}));G.managerLog=G.managerLog||[];G.managerPromise=G.managerPromise||null;G.businessIncome=G.businessIncome||0;G.coachCareer=G.coachCareer||{active:false,path:'',level:0,club:'',board:55,budget:30000000,w:0,d:0,l:0,reputation:0};
function save(){localStorage.setItem('footballLife7',JSON.stringify(G))}
const UI={
 show(page){document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===page));document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id==='page-'+page));this.renderPage(page)},
 renderPage(page){const m={home:this.home,inbox:this.inbox,match:this.match,career:this.career,standings:this.standings,transfer:this.transfer,manager:this.manager,life:this.life,shopping:this.shopping,retire:this.retire,settings:this.settings};m[page]?.call(this)},
 renderTop(){pfName.textContent=G.name;pfClub.textContent=`${G.club} · ${G.pos}`;pfNation.textContent='🇰🇷 '+G.nation;pfAge.textContent=G.age;pfWage.textContent='€'+G.wage+'K';pfMgr.textContent=G.managerTrust;pfFit.textContent=G.fitness+'%';fitBar.style.width=G.fitness+'%';topDate.textContent=`${G.year}년 ${G.month}월 ${G.day}일`;topSub.textContent=`시즌 진행 중 · ${G.club}`;topOvr.textContent=G.ovr;topCond.textContent=G.fitness;topMoney.textContent=money(G.money)},
 home(){document.querySelector('#page-home').innerHTML=`<div class="grid"><div class="panel c8 homeHero"><div class="heroCover"><img src="https://images.unsplash.com/photo-1758600587808-9e251cf34b94?auto=format&fit=crop&crop=faces&q=88&w=1000&h=1350" alt="hero"><div class="heroText"><span class="pill">FOOTBALL LIFE 7.3</span><h1>경기, 관계, 선택이 함께 굴러가는 시즌</h1><div class="btnrow"><button class="btn green" onclick="UI.show('match')">다음 경기 준비</button><button class="btn pink" onclick="UI.show('life')">하린 만나기</button><button class="btn blue" onclick="UI.show('transfer')">이적시장 보기</button></div></div></div><div class="heroAside"><div class="title"><h2>이번 주 핵심</h2><span class="pill">Week ${G.week}</span></div><div class="notice">이번 주는 <b>${G.fixtures[0]?.[0]||'시즌 종료'}</b>전이 예정돼 있어. 컨디션 관리, 감독 신뢰, 하린과의 관계, 이적시장 루머가 모두 연결된다.</div><div class="stat"><span>다음 상대</span><b>${G.fixtures[0]?.[0]||'-'}</b></div><div class="stat"><span>현재 관계</span><b>${G.partner} · ${G.relationStage}</b></div><div class="stat"><span>애정 / 신뢰</span><b>${G.affection} / ${G.trust}</b></div><div class="stat"><span>최근 경기</span><b>${G.lastMatch.opp} · ${G.lastMatch.res}</b></div></div></div><div class="c4 panel pad"><div class="title"><h2>라이브 이벤트</h2><button class="btn" onclick="UI.show('inbox')">전체 보기</button></div><div class="feed">${G.inbox.slice(0,4).map((x,i)=>`<div class="feedItem"><div class="feedIcon">${['🧠','💌','💼','📰'][i%4]}</div><div><h4>${x[0]}</h4><p>${x[1]}</p><small>선택지 3개 대기 중</small></div></div>`).join('')||'<div class="notice">아직 새 이벤트가 없다. 다음 주 진행을 눌러 이벤트를 발생시켜봐.</div>'}</div></div><div class="c12 metricGrid">${[['OVR',G.ovr],['컨디션',G.fitness],['멘탈',G.morale],['감독 신뢰',G.managerTrust]].map(v=>`<div class="panel metric"><small>${v[0]}</small><div class="big">${v[1]}</div></div>`).join('')}</div><div class="c6 panel pad"><div class="title"><h2>주요 뉴스</h2><span class="pill">새 소식</span></div><div class="feed">${G.news.map(n=>`<div class="feedItem"><div class="feedIcon">🗞️</div><div><h4>${n}</h4><small>${G.month}/${G.day}</small></div></div>`).join('')}</div></div><div class="c6 panel pad"><div class="title"><h2>주간 체크리스트</h2></div><div class="feed"><div class="feedItem"><div class="feedIcon">⚽</div><div><h4>경기 준비</h4><p>훈련 또는 회복으로 ${G.fixtures[0]?.[0]||'다음 일정'}전에 컨디션을 맞춘다.</p></div></div><div class="feedItem"><div class="feedIcon">💗</div><div><h4>하린과 시간 보내기</h4><p>카페·쇼핑·집 데이트 중 하나를 선택해 관계를 발전시킨다.</p></div></div><div class="feedItem"><div class="feedIcon">💼</div><div><h4>이적시장 확인</h4><p>관심 구단과 스카우트 리포트를 보고 커리어 방향을 정한다.</p></div></div></div></div></div>`},
 inbox(){document.querySelector('#page-inbox').innerHTML=`<div class="panel pad"><div class="title"><h2>인박스 / 라이브 이벤트</h2><span class="pill">${G.inbox.length}개 대기</span></div><div class="feed">${G.inbox.map((e,idx)=>`<div class="feedItem"><div class="feedIcon">${['🧠','💗','💼','📰','🎽'][idx%5]}</div><div><h4>${e[0]}</h4><p>${e[1]}</p><div class="btnrow" style="margin-top:8px">${e[2].map((c,i)=>`<button class="btn ${i===0?'green':i===1?'blue':''}" onclick="Game.answerEvent(${idx},${i})">${c}</button>`).join('')}</div></div></div>`).join('')||'<div class="notice">현재 처리할 이벤트가 없다. 다음 주를 진행하면 감독, 에이전트, 연애, SNS, 국가대표 관련 새 이벤트가 생성된다.</div>'}</div></div>`},
 match(){const next=G.fixtures[0]||['시즌 종료','-'];const m=G.matchSession;document.querySelector('#page-match').innerHTML=m?`<div class="grid"><div class="c8 panel pad"><div class="title"><h2>LIVE MATCH · ${G.club} vs ${m.opp}</h2><span class="pill">${m.minute}' · ${m.us}:${m.them}</span></div><div class="notice">평점 <b>${m.rating.toFixed(1)}</b> · 체력 ${m.energy} · 남은 결정 ${m.left}. 매 선택은 골/도움/평점/감독 신뢰에 영향을 준다.</div><div class="feed" style="margin-top:10px">${m.log.slice(-7).map(x=>`<div class="feedItem"><div class="feedIcon">⚽</div><div><h4>${x}</h4></div></div>`).join('')}</div><div class="cards3" style="margin-top:12px">${[['shoot','직접 슈팅','득점 확률↑ · 실패 시 평점↓'],['pass','킬패스','도움 확률↑ · 시야 활용'],['dribble','드리블 돌파','고위험 고보상'],['press','강한 압박','감독 신뢰↑ · 체력 소모'],['safe','안전한 연결','평점 안정'],['hero','개인기로 해결','에고 높은 선택 · 극단적 결과']].map(a=>`<button class="card" onclick="Game.matchAction('${a[0]}')"><strong>${a[1]}</strong><p>${a[2]}</p></button>`).join('')}</div></div><div class="c4 panel pad"><div class="title"><h2>경기 상태</h2></div><div class="stat"><span>스코어</span><b>${m.us}:${m.them}</b></div><div class="stat"><span>개인 골</span><b>${m.goals}</b></div><div class="stat"><span>개인 도움</span><b>${m.assists}</b></div><div class="stat"><span>평점</span><b>${m.rating.toFixed(1)}</b></div><div class="stat"><span>컨디션</span><b>${m.energy}</b></div></div></div>`:`<div class="grid"><div class="c7 panel pad"><div class="title"><h2>경기 센터</h2><span class="pill">${next[1]}</span></div><div class="notice">다음 경기는 <b>${G.club} vs ${next[0]}</b>. 자동 결과가 아니라 직접 장면을 선택해 평점과 공격포인트를 만든다.</div><div class="stat"><span>최근 경기</span><b>${G.lastMatch.opp} · ${G.lastMatch.res}</b></div><div class="stat"><span>평점</span><b>${G.lastMatch.rating}</b></div><div class="stat"><span>개인 기록</span><b>${G.lastMatch.goals}골 ${G.lastMatch.assists}도움</b></div><div class="btnrow" style="margin-top:12px"><button class="btn green" onclick="Game.quickTrain()">경기 전 훈련</button><button class="btn blue" onclick="Game.recover(10,0,'수면 회복')">회복 우선</button><button class="btn pink" onclick="Game.startMatch()">경기 시작</button></div></div><div class="c5 panel pad"><div class="title"><h2>시즌 기록</h2></div><div class="stat"><span>출전</span><b>${G.apps}</b></div><div class="stat"><span>골</span><b>${G.goals}</b></div><div class="stat"><span>도움</span><b>${G.assists}</b></div><div class="stat"><span>시장 가치</span><b>€${(4.5+G.ovr*0.12).toFixed(1)}M</b></div><div class="stat"><span>감독 신뢰</span><b>${G.managerTrust}</b></div></div></div>`},
 career(q=''){const s=(q||'').toLowerCase();const list=players.filter(p=>p.join(' ').toLowerCase().includes(s));document.querySelector('#page-career').innerHTML=`<div class="panel pad"><div class="title"><h2>선수 검색 DB</h2><span class="pill">선수 · 감독 · 레전드</span></div><input class="search" value="${q}" placeholder="이름, 국적, 클럽, 역할 검색" oninput="UI.career(this.value)"><div class="cards4" style="margin-top:10px">${list.map(p=>`<div class="card"><strong>${p[0]}</strong><div style="margin:7px 0"><span class="pill">${p[1]}</span> <span class="pill">${p[2]}</span> <span class="pill">${p[3]}</sp